(version 1)
(rule "JLCPCB clearance" (constraint clearance (min 0.2mm)))
(rule "JLCPCB track" (constraint track_width (min 0.2mm)))
(rule "JLCPCB hole" (constraint hole_size (min 0.3mm)))
(rule "JLCPCB annular" (constraint annular_width (min 0.15mm)))
(rule "JLCPCB edge" (constraint edge_clearance (min 0.4mm)))
